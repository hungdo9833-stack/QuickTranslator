<Window x:Class="QuickTranslator.AiEditor.Wpf.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QT Studio · Import Preview" Width="1380" Height="860" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True" PreviewDragOver="OnWindowPreviewDragOver" Drop="OnWindowDrop">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="14,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="SourcePathInput" IsReadOnly="True" ToolTip="Tệp nguồn không bị sửa hoặc di chuyển (hỗ trợ kéo-thả tệp .txt vào cửa sổ)"/>
    <Expander Grid.Column="1" Header="Bảng mã" ToolTip="QT Studio tự nhận diện UTF-8, GBK và GB18030. Chỉ mở khi bản xem trước có ký tự bất thường." Margin="6,0">
      <ComboBox x:Name="EncodingInput" Width="190" SelectedIndex="0"><ComboBoxItem Tag="Auto">Tự động (khuyên dùng)</ComboBoxItem><ComboBoxItem Tag="Utf8">UTF-8</ComboBoxItem><ComboBoxItem Tag="Gbk">GBK · CP936</ComboBoxItem><ComboBoxItem Tag="Gb18030">GB18030</ComboBoxItem><ComboBoxItem Tag="Utf16Le">UTF-16 LE</ComboBoxItem><ComboBoxItem Tag="Utf16Be">UTF-16 BE</ComboBoxItem></ComboBox>
    </Expander>
    <Button Grid.Column="2" Content="Chọn TXT…" Click="OnBrowse"/>
    <Button Grid.Column="3" Content="Phân tích" Style="{StaticResource Primary}" Click="OnAnalyze"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CHƯƠNG MỚI" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="NewCountText" Text="0 chương" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="ĐÃ CÓ" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ExistingCountText" Text="0 chương" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CẦN KIỂM TRA" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ProblemCountText" Text="0 mục" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CÓ THỂ NHẬP" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ImportCountText" Text="0 chương" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SourceSummaryText" Text="Chưa chọn tệp" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SkipExistingButton" Content="Bỏ qua chương đã có" Click="OnSkipExisting" ToolTip="Chỉ giữ các chương mới; không ghi đè chương trong Project"/><Button x:Name="TranslateAllTitlesButton" Content="Dịch tất cả" Style="{StaticResource Primary}" Click="OnTranslateAllTitles"/><Button x:Name="RetryFailedTitlesButton" Content="Dịch lại mục lỗi" Click="OnRetryFailedTitles"/><Button x:Name="RetrySelectedTitlesButton" Content="Dịch lại mục đã chọn" Click="OnRetrySelectedTitles"/><Button x:Name="CancelTitleTranslationButton" Content="Hủy" Click="OnCancelTitleTranslation" IsEnabled="False"/></StackPanel>
   <StackPanel>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="TranslateTitlesCheck" Content="Dịch tiêu đề sang tiếng Việt" VerticalAlignment="Center" Margin="4" Checked="OnTitleTranslationOptionChanged" Unchecked="OnTitleTranslationOptionChanged"/><ComboBox x:Name="TitleMethodInput" Width="210" SelectedIndex="0" Margin="6,2"><ComboBoxItem Tag="Ollama">AI Ollama đang chọn</ComboBoxItem><ComboBoxItem Tag="HanViet">Hán Việt</ComboBoxItem><ComboBoxItem Tag="VietPhrase">VietPhrase</ComboBoxItem><ComboBoxItem Tag="KeepChinese">Giữ nguyên tiếng Trung</ComboBoxItem></ComboBox><TextBlock x:Name="TitleTranslationProgressText" Text="Chưa dịch tiêu đề" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0"/></StackPanel>
     <TextBlock x:Name="PreviewStatusText" Text="Chọn hoặc kéo-thả TXT để bắt đầu" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,3,4,0"/>
     <TextBlock x:Name="CoverageSummaryText" Text="Coverage Ledger chưa có dữ liệu" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,3,4,0"/>
    <CheckBox x:Name="ReplaceHistoryCheck" Content="Ghi đè các chương trùng trong History (xóa vĩnh viễn bản cũ)"
              Visibility="Collapsed" Margin="4,5,4,0" Foreground="{DynamicResource WarningBrush}"
              ToolTip="Chỉ thay thế chương đã xóa mềm có cùng ChapterId. Chương đang hoạt động vẫn được bảo vệ."
              Checked="OnReplaceHistoryChanged" Unchecked="OnReplaceHistoryChanged"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="Lọc danh sách" FontSize="17" FontWeight="SemiBold" Margin="4,2,4,8"/><TextBox x:Name="SearchInput" ToolTip="Tìm số, tên hoặc quyển" TextChanged="OnFilterChanged"/><ComboBox x:Name="FilterInput" SelectedIndex="0" SelectionChanged="OnFilterChanged"><ComboBoxItem Tag="All">Tất cả vùng</ComboBoxItem><ComboBoxItem Tag="Problems">Chỉ mục có vấn đề</ComboBoxItem><ComboBoxItem Tag="Duplicates">Chương trùng</ComboBoxItem><ComboBoxItem Tag="Uncertain">Ranh giới chưa chắc</ComboBoxItem><ComboBoxItem Tag="MissingNumber">Chương thiếu số</ComboBoxItem><ComboBoxItem Tag="Included">Chỉ chương sẽ nhập</ComboBoxItem><ComboBoxItem Tag="Unclassified">Vùng chưa phân loại</ComboBoxItem></ComboBox><TextBlock Text="Cảnh báo" Foreground="{DynamicResource MutedBrush}" Margin="4,14,4,4"/></StackPanel>
    <ListBox x:Name="IssuesList" Background="Transparent" Foreground="{DynamicResource WarningBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3,5"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" SelectionChanged="OnSelectionChanged" CellEditEnding="OnPreviewCellEditEnding" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AlternationCount="2">
    <DataGrid.Columns><DataGridTextColumn Header="Nhập" Binding="{Binding IncludedLabel}" Width="55" IsReadOnly="True"/><DataGridTextColumn Header="Số" Binding="{Binding NumberLabel}" Width="68" IsReadOnly="True"/><DataGridTextColumn Header="Tiêu đề Trung" Binding="{Binding Title}" Width="1.4*" IsReadOnly="True"/><DataGridTextColumn Header="Tiêu đề Việt" Binding="{Binding VietnameseTitle, Mode=OneWay}" Width="1.6*"/><DataGridTextColumn Header="Quyển" Binding="{Binding VolumeTitle}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Nhận diện" Binding="{Binding Status}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="Cảnh báo" Binding="{Binding ProblemLabel}" Width="1.5*" IsReadOnly="True"/></DataGrid.Columns>
   </DataGrid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Kiểm tra &amp; sửa" FontSize="17" FontWeight="SemiBold" Margin="4,2,4,8"/>
    <TextBlock Text="Số chương" Foreground="{DynamicResource MutedBrush}" Margin="4,5,4,0"/><TextBox x:Name="NumberInput"/>
    <TextBlock Text="Tên chương" Foreground="{DynamicResource MutedBrush}" Margin="4,5,4,0"/><TextBox x:Name="TitleInput"/>
     <WrapPanel><Button Content="Áp dụng số / tên" Style="{StaticResource Primary}" Click="OnApplyEdit"/><Button x:Name="IncludeButton" Content="Include / Exclude" Click="OnToggleInclude"/></WrapPanel>
     <WrapPanel><Button x:Name="ConfirmBoundaryButton" Content="Xác nhận tiêu đề thật" Click="OnConfirmBoundary"/><Button x:Name="RejectBoundaryButton" Content="Loại ranh giới giả" Click="OnRejectFalseBoundary" ToolTip="Giữ nguyên dòng tiêu đề và nội dung, nối trở lại chương vật lý trước"/></WrapPanel>
    <WrapPanel><Button Content="Tách tại dòng…" Click="OnSplit"/><Button Content="Gộp với chương sau" Click="OnMerge"/><Button Content="Dời ranh giới…" Click="OnMoveBoundary"/><Button x:Name="UndoButton" Content="Hoàn tác" Click="OnUndo"/></WrapPanel>
    <TextBlock Text="Quanh điểm bắt đầu" Foreground="{DynamicResource MutedBrush}" Margin="4,14,4,2"/><TextBox x:Name="StartContextText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    <TextBlock Text="Quanh điểm kết thúc" Foreground="{DynamicResource MutedBrush}" Margin="4,10,4,2"/><TextBox x:Name="EndContextText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="145" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    <TextBlock x:Name="SelectedDetailText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,10"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"><DockPanel>
   <TextBlock x:Name="FooterHintText" Text="Nguồn chỉ được đọc; mọi sửa trong preview không đổi file TXT." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hủy" Click="OnCancel"/><Button x:Name="ConfirmButton" Content="Nhập" Click="OnConfirm" IsEnabled="False"/><Button x:Name="ImportAndTranslateButton" Content="Nhập &amp; Dịch" Style="{StaticResource Primary}" Click="OnConfirmAndTranslate" IsEnabled="False" ToolTip="Nhập các chương mới và bắt đầu dịch ngay"/></StackPanel>
  </DockPanel></Border>
 </Grid>
</Window>
